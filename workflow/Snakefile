rule format_config_file:
    input:
        "resources/configs/samplesheet.template.csv",
    output:
        rendered_csv="results/config/nfcore-genomeassembler.config.csv",
    params:
        dataset_id=dataset_id,
        ont_reads=Path(rules.ont_tar_to_fastq.output.reads).resolve(),
    template_engine:
        "jinja2"


rule config_target:
    default_target: True
    localrule: True
    input:
        rules.samtools_import.input,
        rules.ont_tar_to_fastq.output,
        rules.format_config_file.output.rendered_csv,
